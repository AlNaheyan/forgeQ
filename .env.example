APP_ENV=development

HTTP_PORT=8080
GRPC_PORT=9090

DATABASE_URL=postgres://forgequeue:forgequeue@localhost:55432/forgequeue?sslmode=disable
REDIS_ADDR=localhost:6379
COORDINATOR_ADDR=localhost:9090

HEARTBEAT_INTERVAL=5s
WORKER_TIMEOUT=15s
LEASE_DURATION=30s
LEASE_RENEW_INTERVAL=10s
LEASE_SCAN_INTERVAL=1s
RETRY_BASE_DELAY=2s
RETRY_MAX_DELAY=60s
RETRY_PROMOTION_INTERVAL=250ms
QUEUE_RECONCILE_INTERVAL=10s

DEFAULT_MAX_ATTEMPTS=3
MAX_QUEUE_DEPTH=100000
WORKER_CONCURRENCY=4
WORKER_ID=
WORKER_JOB_TYPES=sleep,fail
WORKER_POLL_INTERVAL=250ms

LOG_LEVEL=info

APP_ENV=development

HTTP_PORT=8080
GRPC_PORT=9090

DATABASE_URL=postgres://forgequeue:forgequeue@localhost:55432/forgequeue?sslmode=disable
REDIS_ADDR=localhost:6379

HEARTBEAT_INTERVAL=5s
WORKER_TIMEOUT=15s
LEASE_DURATION=30s
LEASE_RENEW_INTERVAL=10s
QUEUE_RECONCILE_INTERVAL=10s

DEFAULT_MAX_ATTEMPTS=3
MAX_QUEUE_DEPTH=100000
WORKER_CONCURRENCY=4
WORKER_ID=
WORKER_JOB_TYPES=sleep,fail
WORKER_POLL_INTERVAL=250ms

LOG_LEVEL=info

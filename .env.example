APP_ENV=development

HTTP_PORT=8080
GRPC_PORT=9090
METRICS_PORT=9101

DATABASE_URL=postgres://forgequeue:forgequeue@localhost:55432/forgequeue?sslmode=disable
REDIS_ADDR=localhost:6379
COORDINATOR_ADDR=localhost:9090

HEARTBEAT_INTERVAL=5s
WORKER_TIMEOUT=15s
LEASE_DURATION=30s
LEASE_RENEW_INTERVAL=10s
LEASE_SCAN_INTERVAL=1s
RETRY_BASE_DELAY=2s
RETRY_MAX_DELAY=60s
RETRY_PROMOTION_INTERVAL=250ms
QUEUE_RECONCILE_INTERVAL=10s

DEFAULT_MAX_ATTEMPTS=3
MAX_QUEUE_DEPTH=100000
WORKER_CONCURRENCY=4
WORKER_ID=
# The built-in worker supports only sleep/fail; application handlers use the SDK.
WORKER_JOB_TYPES=sleep,fail
# Application task names accepted by the API; register handlers in your worker.
FORGEQ_JOB_TYPES=
WORKER_POLL_INTERVAL=250ms
SCHEDULER_STRATEGY=least_loaded

# Optional Wave 14 lifecycle-event stream; leave disabled unless Kafka is running.
EVENTS_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=forgequeue.events
EVENT_PUBLISH_INTERVAL=500ms
EVENT_OUTBOX_LEASE=30s
EVENT_BATCH_SIZE=100

LOG_LEVEL=info
# Generate with openssl rand -hex 32; required by api/coordinator/worker.
CONTROL_PLANE_TOKEN=
# Tenant HTTP credential, used by loadgen and chaos tools (not a service token).
FORGEQUEUE_API_KEY=

# Opt-in bounded cleanup; keyed jobs/execution markers remain indefinitely.
RETENTION_ENABLED=false
RETENTION_JOB_AGE=720h
RETENTION_EVENT_AGE=168h
RETENTION_BATCH=100
# Operations overlay also requires unique POSTGRES_PASSWORD and
# GRAFANA_ADMIN_PASSWORD. Use random hex to keep DATABASE_URL safe.
